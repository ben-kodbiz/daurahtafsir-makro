            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            display: block;
        }
        
        .widget-grid-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
            background: rgba(255, 255, 255, 1);
        }
        
        .widget-grid-content {
            padding: 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 120px;
        }
        
        .widget-grid-icon {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .widget-grid-label {
            font-size: 1rem;
            font-weight: 500;
            color: #333;
            line-height: 1.4;
        }
        
        .widget-grid-item:hover .widget-grid-label {
            color: #667eea;
        }
        
        /* Category Headers */
        .category-header {
            grid-column: 1 / -1;
            margin: 30px 0 15px 0;
            padding: 10px 0;
            border-bottom: 2px solid rgba(255, 255, 255, 0.5);
        }
        
        .category-header h2 {
            color: white;
            font-size: 1.5rem;
            text-align: center;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .widget-grid-container {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 15px;
            }
            
            .widget-grid-content {
                padding: 15px;
                min-height: 100px;
            }
            
            .widget-grid-icon {
                font-size: 2rem;
            }
            
            .widget-grid-label {
